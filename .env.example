# Required for the judged run
ANTHROPIC_API_KEY=

# Optional model choices
ROUTER_MODEL=claude-opus-5-5
FALLBACK_MODEL=claude-sonnet-5-5

# Optional: where P0 escalations are posted (our own service, which places the ElevenLabs call). Unset => page not placed, case still completes.
ESCALATION_WEBHOOK_URL=
OUT_DIR=./ANSWERS
PORT=8787

# Optional shadow classifier (TypeSafe AI Jev). Unset => regex flags only.
TYPESAFE_API_KEY=
JEV_MODE=shadow

# Optional: hosted Postgres (Neon/Supabase). Unset => PGlite in-process, zero setup.
DATABASE_URL=

# Optional, demo only. Unset => messages/calls are recorded in the trace and DB only.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ONCALL_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
ELEVENLABS_WEBHOOK_SECRET=        # verifies the post-call webhook that writes callback.json
ONCALL_WHATSAPP_NUMBER=           # WhatsApp page for a P0; falls back to ONCALL_PHONE_NUMBER
LANDLORD_PHONE_NUMBER=            # used when an escalation names the landlord as the recipient
DEMO_TENANT_WHATSAPP=             # demo only: the tenant number that receives executed replies
PUBLIC_URL=                       # public URL of this service (tunnel) for Twilio signature checks and webhooks
WHATSAPP_POLL=                    # 1 => poll Twilio for inbound WhatsApp (no public URL needed)
PAGE_HOLD_MS=120000               # a live P0 page waits this long for the property to be identified
CASES_DIR=                        # the runner's --cases, so the service can read the original report
DATA_DIR=                         # the runner's --data (demo dataset for live cases)
LIVE_OUT_DIR=./out/live           # where inbound WhatsApp cases are written

# Optional, demo dashboard (dashboard/): folders to watch, comma separated; API port
OUT_DIRS=./out/sample
API_PORT=8788

# Optional shadow classifier extras
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=

# Optional: an organiser-supplied MCP tool server (sketch in src/backend/mcp.ts). Unset => record store only.
MCP_URL=
